FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production
DATABASE_URL=sqlite:///shantikunj.db

# Inventory defaults used when the database is initialized.
DEFAULT_TOTAL_GADDA=50
DEFAULT_TOTAL_RAJAI=50
DEFAULT_DEPOSIT_PER_ITEM=50

# SMS integration. Leave SMS_ENABLED=false during local testing.
SMS_ENABLED=false
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=SHKREG
